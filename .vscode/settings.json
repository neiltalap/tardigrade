{
  // modules-spike branch: tardigrade builds as a Go module
  // (go.mod at repo root). Open /home/neil/tardigrade directly;
  // no GOPATH layout needed. Plain `go build ./...` and
  // `go test` work with GOFLAGS=-mod=mod (or plain defaults
  // once go.mod/go.sum are complete).
  // Full test/cluster runs still need the 2019 builder image
  // (c-deps: jemalloc, libroach headers).
  "go.testTimeout": "10m",
  // Quiet the tree: generated + test files nest under their source,
  // build outputs and module cache noise stay hidden. The 400k-line
  // hand-written core is what's left visible at top level.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.go": "${capture}.pb.go, ${capture}.pb.gw.go, ${capture}.og.go, ${capture}_test.go, ${capture}_bench_test.go",
    "sql.go": "sql-gen.y, sql.go.tmp",
    "keywords.go": "reserved_keywords.go",
    "memo": "memo/*.og.go"
  },
  "files.exclude": {
    "**/testdata": true,
    "**/*.test": true,
    "**/*.out": true,
    "bin/": true
  }
}
