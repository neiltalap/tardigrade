·                    table              b@idx
·                    spans              /!NULL-
·                    filter             (a_y IS NOT NULL) AND (a_x IS NOT NULL)

statement ok
ALTER TABLE b VALIDATE CONSTRAINT fk_ref

# Now the plan should be simplified.
query TTT colnames
EXPLAIN SELECT
